---
import { resume } from "../data/resume";

const { name, location, intro, experience, projects, skills, education, links } = resume;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={intro} />
    <title>{name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <main>
      <header>
        <h1>{name}</h1>
        <p class="meta">{location}</p>
        <p class="intro">{intro}</p>
      </header>

      <section id="experience" aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        {
          experience.map((job) => (
            <article class:list={["entry", { todo: job.todo }]}>
              <h3>
                {job.title}
                {job.todo && <span class="badge">TODO</span>}
              </h3>
              <p class="meta">
                {job.company}
                {job.dates && <> · {job.dates}</>}
              </p>
              <ul>
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        {
          projects.map((p) => (
            <article class:list={["entry", { todo: p.todo }]}>
              <h3>
                <a href={p.url} rel="noopener noreferrer">{p.name}</a>
                {p.todo && <span class="badge">TODO</span>}
              </h3>
              <p>{p.description}</p>
            </article>
          ))
        }
      </section>

      <section id="skills" aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills</h2>
        <dl class="skills">
          {
            skills.map((group) => (
              <>
                <dt>{group.label}</dt>
                <dd>{group.items.join(", ")}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section id="education" aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        {
          education.map((e) => (
            <article class="entry">
              <h3>{e.school}</h3>
              <p class="meta">{e.degree}</p>
              <p class="meta">{e.dates}</p>
            </article>
          ))
        }
      </section>

      <section id="links" aria-labelledby="links-heading">
        <h2 id="links-heading">Links</h2>
        <ul class="links">
          {
            links.map((l) => {
              const isMail = l.href.startsWith("mailto:");
              return (
                <li>
                  <a
                    href={l.href}
                    rel={isMail ? undefined : "noopener noreferrer"}
                  >
                    {isMail ? l.href.slice("mailto:".length) : l.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>

    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #5c5c5c;
        --accent: #1d4ed8;
        --border: #d4d4d8;
        --badge-bg: #fef3c7;
        --badge-fg: #78350f;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121212;
          --fg: #ededed;
          --muted: #a1a1aa;
          --accent: #93c5fd;
          --border: #3f3f46;
          --badge-bg: #422006;
          --badge-fg: #fde68a;
        }
      }

      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
      }
      main {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        overflow-wrap: break-word;
      }
      h1 {
        font-size: 2.25rem;
        line-height: 1.2;
        margin: 0 0 0.5rem;
      }
      .intro {
        color: var(--muted);
        margin: 0;
      }
      section {
        margin-top: 2.5rem;
      }
      h2 {
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.4rem;
        margin: 0 0 1rem;
      }
      h3 {
        font-size: 1.05rem;
        margin: 0;
      }
      h3 a {
        color: var(--accent);
      }
      .entry {
        margin-bottom: 1.5rem;
      }
      .meta {
        color: var(--muted);
        margin: 0.15rem 0 0.4rem;
      }
      ul {
        padding-left: 1.25rem;
        margin: 0.4rem 0 0;
      }
      li {
        margin-bottom: 0.35rem;
      }
      p {
        margin: 0.3rem 0;
      }
      a {
        color: var(--accent);
      }
      .badge {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        vertical-align: middle;
        padding: 0.1rem 0.45rem;
        border-radius: 0.3rem;
        background: var(--badge-bg);
        color: var(--badge-fg);
      }
      .entry.todo,
      .todo {
        border: 1px dashed var(--border);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
      }
      .skills {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.25rem 1rem;
        margin: 0;
      }
      .skills dt {
        font-weight: 600;
        margin-top: 0.6rem;
      }
      .skills dd {
        margin: 0;
        color: var(--muted);
      }
      .links {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
      }
      .links li {
        margin: 0;
      }
      @media (min-width: 40rem) {
        .skills {
          grid-template-columns: 12rem 1fr;
        }
      }
    </style>
  </body>
</html>
